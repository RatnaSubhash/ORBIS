# ORBIS Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env files containing sensitive values to version control.

# Environment mode: development, test, production
ORBIS_ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Local SQLite Database Path
DB_PATH=orbis.db

# Local LLM (Ollama) Settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60.0

# Phase 2: Passive Observation Settings
OBSERVATION_ENABLED=true
# Default polling interval in seconds (3.0s balances responsiveness and <0.5% CPU overhead)
OBSERVATION_INTERVAL=3.0

# Allowed Workspace Root for FileTool (resolves relative to current directory if '.')
ALLOWED_WORKSPACE_ROOT=.

# Phase 3: Session Segmentation Settings
# Inactivity threshold in minutes between consecutive events to split sessions (default: 15 minutes)
SESSION_GAP_MINUTES=15.0

# Phase 4: Knowledge Graph & Semantic Vector Memory Settings
# Default local sentence-transformers model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Path to persistent FAISS index file on disk
VECTOR_INDEX_PATH=orbis_vectors.faiss

# Excluded Processes (JSON array or comma-separated list of process names to ignore)
EXCLUDED_PROCESSES='["1password.exe", "bitwarden.exe", "keepass.exe", "lastpass.exe"]'

# Excluded Window Title Substrings (to prevent recording credential/banking titles)
EXCLUDED_WINDOW_TITLES='["1Password", "Bitwarden", "KeePass", "Sign In", "Authentication"]'

